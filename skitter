#!/bin/sh
#
# The daily loop, in one command.
#
# `./gradlew assembleDebug` is only the first third of trying a change: the rest is finding the APK,
# installing it, working out the component name to launch, and then finding your own program's output
# in a log that every process on the device is also writing to. This script is those steps, and it is
# in the repository beside `gradlew` for the same reason `gradlew` is — a build you clone should not
# also need something installed to drive it.
#
#     ./skitter run          build, install, launch, and follow the log
#     ./skitter build        just build the debug APK
#     ./skitter install      install what was last built
#     ./skitter log          follow the log of a running app
#     ./skitter release      build an unsigned (or signed) release APK
#     ./skitter clean        throw away Gradle's output and sbt's
#
# **Two environment problems are solved here rather than documented**, because both produce errors
# that name something other than themselves.

set -e

here=$(cd "$(dirname "$0")" && pwd)
cd "$here"

# **Gradle needs a JDK between 17 and 25, and a newer one fails with a Kotlin/Gradle stack trace that
# never mentions the version.** Android Studio bundles its own and is unaffected, so this bites only
# in a terminal — and on a machine whose `java` is 26, which is an ordinary thing for a machine to be.
# Any JDK in range will do, so one is looked for rather than demanded.
if [ -z "$JAVA_HOME" ] || ! "$JAVA_HOME/bin/java" -version 2>&1 | grep -qE '"(1[7-9]|2[0-5])[.\"]'; then
    for v in 25 24 23 22 21 20 19 18 17; do
        candidate=$(/usr/libexec/java_home -v "$v" 2>/dev/null || true)

        if [ -n "$candidate" ]; then
            JAVA_HOME=$candidate
            export JAVA_HOME
            break
        fi
    done
fi

if [ -z "$JAVA_HOME" ]; then
    echo "skitter: no JDK between 17 and 25 found, and Gradle will not run on a newer one." >&2
    echo "         Install one (brew install openjdk@21) or set JAVA_HOME to one you have." >&2
    exit 1
fi

# **`ANDROID_HOME` is read by Gradle, by the NDK lookup and by this script**, and its absence surfaces
# as a CMake error about a missing toolchain rather than as a missing variable.
if [ -z "$ANDROID_HOME" ]; then
    if [ -d "$HOME/Library/Android/sdk" ]; then
        ANDROID_HOME="$HOME/Library/Android/sdk"
    elif [ -d "$HOME/Android/Sdk" ]; then
        ANDROID_HOME="$HOME/Android/Sdk"
    else
        echo "skitter: ANDROID_HOME is not set and no SDK was found in the usual place." >&2
        exit 1
    fi

    export ANDROID_HOME
fi

adb="$ANDROID_HOME/platform-tools/adb"

# Your application id, read from the one file that has it. The activity is Skitter's and its name is
# the same in every project, which is what makes the component name below computable at all.
app_id=$(sed -n 's/^skitter\.applicationId=//p' gradle.properties | tr -d ' \r')
component="$app_id/sh.sysl.skitter.SkitterActivity"

if [ -z "$app_id" ]; then
    echo "skitter: no skitter.applicationId in gradle.properties" >&2
    exit 1
fi

need_aar() {
    if ! ls app/libs/*.aar >/dev/null 2>&1; then
        echo "skitter: SDL3's AAR is not here yet — fetching it once."
        ./fetch-sdl3.sh
    fi
}

need_device() {
    if [ -z "$("$adb" devices | sed '1d' | grep -w device || true)" ]; then
        echo "skitter: no device or emulator is attached." >&2
        echo "         Start one with: \$ANDROID_HOME/emulator/emulator -list-avds" >&2
        exit 1
    fi
}

case "${1:-run}" in
    build)
        need_aar
        ./gradlew assembleDebug
        ;;

    release)
        need_aar
        ./gradlew assembleRelease
        ;;

    install)
        need_device
        "$adb" install -r app/build/outputs/apk/debug/app-debug.apk
        ;;

    run)
        need_aar
        ./gradlew assembleDebug
        need_device
        "$adb" install -r app/build/outputs/apk/debug/app-debug.apk
        # Cleared before launching, so that what follows is this run and not the last one.
        "$adb" logcat -c
        "$adb" shell am start -n "$component"
        echo
        echo "── $app_id ── ^C to stop following the log ──"
        # `SDL/APP` is where a sysl `print` ends up on Android, since SDL redirects the standard
        # streams into the log. The rest is what fails loudly enough to matter.
        "$adb" logcat -s SDL/APP:V SDL:W skitter:V AndroidRuntime:E DEBUG:E
        ;;

    log)
        need_device
        "$adb" logcat -s SDL/APP:V SDL:W skitter:V AndroidRuntime:E DEBUG:E
        ;;

    clean)
        ./gradlew clean || true
        rm -rf app/.cxx activity/target program/*.a program/*.a.h
        echo "skitter: cleaned. The SDL3 AAR in app/libs is kept — ./fetch-sdl3.sh re-downloads it."
        ;;

    *)
        sed -n '3,20p' "$0" | sed 's/^# \{0,1\}//'
        exit 1
        ;;
esac
