<?xml version="1.0" encoding="utf-8"?>
<!--
    Trimmed from SDL's own `android-project` template, which is the authoritative version of this
    file — the `configChanges` list in particular is not a style choice. SDL draws into one surface
    and handles rotation, keyboards and window resizes itself, so every configuration change named
    there is one Android must *not* respond to by destroying and recreating the activity.

    What was dropped: the commented-out permission blocks for audio recording, the camera, Bluetooth
    and the network, and the USB and file-drop intent filters. A program that wants one takes it back
    from https://github.com/libsdl-org/SDL/blob/main/android-project/app/src/main/AndroidManifest.xml
    rather than from memory.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:installLocation="auto">

    <uses-feature android:glEsVersion="0x00020000" />

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- Game controllers, over Bluetooth or USB. Not required: a phone has none of it. -->
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.gamepad"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <!-- A real mouse, which is a Chromebook or a desktop-mode phone rather than a handset. -->
    <uses-feature
        android:name="android.hardware.type.pc"
        android:required="false" />

    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:label="@string/app_name"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="false"
        android:hardwareAccelerated="true"
        android:theme="@style/AppTheme">

        <!--
            **Skitter's activity, named in full, and it is not in this application's package.** A
            launcher activity does not have to be — `android:name` takes any class on the classpath,
            and the shorthand `.MainActivity` is only a spelling relative to the package. Naming
            Skitter's directly is what lets `applicationId` above be any string you like: the JNI
            symbol that reports the system bars is mangled from *this* class's package, so fixing the
            class fixes the symbol, and the sysl side of the bridge can live in a library.

            Leave this line alone. Your application's name is in `gradle.properties`.
        -->
        <activity
            android:name="sh.sysl.skitter.SkitterActivity"
            android:label="@string/app_name"
            android:alwaysRetainTaskState="true"
            android:launchMode="singleInstance"
            android:configChanges="layoutDirection|locale|grammaticalGender|fontScale|fontWeightAdjustment|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:preferMinimalPostProcessing="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
